{
  "extends": "@repo/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    // MCP 官方 SDK 用 getter/setter 声明传输回调（`get onclose(): (() => void) | undefined`），
    // 与 exactOptionalPropertyTypes 不兼容（TS2379：含 undefined 的属性无法赋给可选属性）；
    // 仅 mcp 包放宽该标志，其余严格标志（strict/noUncheckedIndexedAccess/verbatimModuleSyntax 等）保持不变
    "exactOptionalPropertyTypes": false
  },
  "include": ["src", "test", "vitest.config.ts"]
}
