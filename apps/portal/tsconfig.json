{
  "extends": "@repo/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/*"] },
    "noEmit": true,
    // shadcn 官方组件（如 sonner.tsx）与 exactOptionalPropertyTypes 不兼容（上游
    // `as ToasterProps["theme"]` 索引访问可选属性会并入 undefined，CLI 产物无法修复）；
    // 与 apps/web 同因放宽，其余严格标志保持不变
    "exactOptionalPropertyTypes": false
  },
  "include": ["src", "vite.config.ts"]
}
