{
  "extends": "@repo/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/*"] },
    "noEmit": true,
    // shadcn 官方组件（如 sonner.tsx）与 exactOptionalPropertyTypes 不兼容（上游 `as ToasterProps["theme"]`
    // 索引访问可选属性会并入 undefined，CLI --diff/--overwrite 无法修复上游产物）；
    // 仅 web 包放宽该标志，其余严格标志（strict/noUncheckedIndexedAccess/verbatimModuleSyntax 等）保持不变
    "exactOptionalPropertyTypes": false
  },
  "include": ["src", "test", "vite.config.ts", "vitest.config.ts"]
}
