# 必须是相对路径 /api：请求经 Vite proxy（开发）或 nginx 反代（生产）同源转发到后端。
# 不要填绝对地址（如 http://localhost:3001/api）——后端未启用 CORS，浏览器会直接拦截跨域请求。
VITE_API_BASE="/api"
# 认证提供方：local（账号密码/动态码 + JWT）| clerk（Clerk 托管登录）
VITE_AUTH_PROVIDER="local"
# Clerk 模式（VITE_AUTH_PROVIDER=clerk）必需：https://dashboard.clerk.com → API Keys → Publishable key
VITE_CLERK_PUBLISHABLE_KEY=""
# 系统品牌名（展示配置）：侧边栏/登录页品牌区与 <title> 使用；不配置则显示空
VITE_APP_NAME="shadova"
