{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx --env-file=.env dist/index.js",
    "test": "vitest run",
    "lint": "eslint src test scripts",
    "typecheck": "tsc --noEmit",
    "generate:openapi": "pnpm --filter @repo/shared build && pnpm --filter @repo/db build && tsx scripts/generate-openapi.ts",
    "generate:types": "openapi-typescript openapi.json -o ../web/src/api/schema.d.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.0",
    "@hono/node-server": "^1.13.0",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.18.0",
    "@repo/db": "workspace:*",
    "@repo/shared": "workspace:*",
    "hono": "^4.6.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "^26.1.2",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
