// 数据库权威 schema（三方言可移植：SQLite / MySQL / PostgreSQL）
// 全字段中文 docstring 为强制规范，须与 docs/database/schema.sql（Task 5，MySQL DDL）双源同步
// 三方言约定见 docs/business/README.md §8：不用 Prisma enum，字符串 + zod 校验

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // 开发默认 SQLite，切换 MySQL/PostgreSQL 见 docs/database/README.md
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 用户账号（统一认证主体：账号密码 / Clerk / 动态码三种登录方式共用）
model User {
  /// 主键（cuid 全局唯一）
  id            String         @id @default(cuid())
  /// 登录用户名（统一小写存储）
  username      String         @unique
  /// 密码哈希（scrypt 算法；Clerk 用户可为空字符串）
  passwordHash  String
  /// 显示昵称
  nickname      String
  /// 邮箱（可空，邮箱动态码登录用；统一小写存储）
  email         String?        @unique
  /// 手机号（可空）
  telephone     String?        @unique
  /// 头像文件名（上传到 /api/files，访问路径 /api/files/{avatar}）
  avatar        String?
  /// 所属部门 ID（组织归属；不参与权限计算，null=未分配）
  departmentId  String?
  /// Clerk 用户 ID 映射（Clerk 登录时关联）
  clerkId       String?        @unique
  /// 启用状态（false=禁用）
  status        Boolean        @default(true)
  /// 创建时间（UTC）
  createdAt     DateTime       @default(now())
  /// 更新时间（UTC）
  updatedAt     DateTime       @updatedAt
  /// 用户角色关联
  roles         UserRole[]
  /// 刷新令牌记录
  refreshTokens RefreshToken[]
  /// 动态码记录（邮箱/手机号验证码）
  otpCodes      OtpCode[]
  /// 登录日志记录（登录成功/失败审计，失败也保留历史）
  loginLogs     LoginLog[]
  /// 操作日志记录（写操作审计，用户删除时级联删除）
  operationLogs OperationLog[]
  /// 站内通知记录（用户删除时级联删除）
  notifications Notification[]
  /// 所属部门（部门删除时置空，不级联删用户）
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
}

/// 部门表（组织架构树；仅组织归属，不参与权限交集计算）
model Department {
  /// 主键（cuid 全局唯一）
  id        String   @id @default(cuid())
  /// 中文名称（zh 界面展示）
  nameZh    String
  /// 英文名称（en 界面展示，未填回落 nameZh）
  nameEn    String?
  /// 上级部门 ID（null=根部门）
  parentId  String?
  /// 排序值（同层展示顺序）
  sort      Int      @default(0)
  /// 启用状态（false=禁用）
  status    Boolean  @default(true)
  /// 创建时间（UTC）
  createdAt DateTime @default(now())
  /// 更新时间（UTC）
  updatedAt DateTime @updatedAt
  /// 子部门（父部门删除时级联删除——onDelete 定义在 parent 引用侧）
  children  Department[] @relation("DepartmentChildren")
  /// 上级部门
  parent    Department?  @relation("DepartmentChildren", fields: [parentId], references: [id], onDelete: Cascade)
  /// 部门内用户（部门删除时置空）
  users     User[]
}

/// 角色（权限分组，通过 UserRole 关联用户、RoleMenu 关联菜单权限）
model Role {
  /// 主键（cuid 全局唯一）
  id          String     @id @default(cuid())
  /// 中文名称（zh 语言展示）
  nameZh      String
  /// 英文名称（en 语言展示，未填回落 nameZh）
  nameEn      String?
  /// 角色编码（如 ADMIN，程序判断用）
  code        String     @unique
  /// 角色描述
  description String?
  /// 排序值（列表展示顺序）
  sort        Int        @default(0)
  /// 启用状态（false=禁用）
  status      Boolean    @default(true)
  /// 创建时间（UTC）
  createdAt   DateTime   @default(now())
  /// 更新时间（UTC）
  updatedAt   DateTime   @updatedAt
  /// 用户角色关联
  users       UserRole[]
  /// 角色菜单权限关联
  menus       RoleMenu[]
}

/// 菜单/按钮权限（自关联树；类型约束见 parentId 注释）
model Menu {
  /// 主键（cuid 全局唯一）
  id         String     @id @default(cuid())
  /// 父节点 ID（null=根；类型约束: DIR→DIR/MENU, MENU→BUTTON, BUTTON→无子级）
  parentId   String?
  /// 中文名称（zh 语言展示）
  nameZh     String
  /// 英文名称（en 语言展示，未填回落 nameZh）
  nameEn     String?
  /// 类型（DIR 目录 / MENU 菜单 / BUTTON 按钮，字符串 + zod 校验，兼容三方言）
  type       String
  /// 路由路径（MENU 必填，如 /system/user）
  path       String?
  /// 前端组件注册 key（MENU 必填）
  component  String?
  /// lucide 图标名（DIR/MENU 用）
  icon       String?
  /// 权限码（MENU/BUTTON 用，如 system:user:add；DB 唯一索引强制，P2002 冲突转 409 + 应用层语义校验）
  permission String?    @unique
  /// 同层排序值
  sort       Int        @default(0)
  /// 启用状态（false=禁用）
  status     Boolean    @default(true)
  /// 创建时间（UTC）
  createdAt  DateTime   @default(now())
  /// 更新时间（UTC）
  updatedAt  DateTime   @updatedAt
  /// 子节点（级联删除）
  children   Menu[]     @relation("MenuTree")
  /// 父节点（删除父节点时级联删除子节点）
  parent     Menu?      @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  /// 角色菜单权限关联
  roles      RoleMenu[]
}

/// 用户-角色关联（联合主键防重复）
model UserRole {
  /// 用户 ID
  userId String
  /// 角色 ID
  roleId String
  /// 关联用户（级联删除）
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 关联角色（级联删除）
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// 联合主键（同一用户同一角色仅一条）
  @@id([userId, roleId])
}

/// 角色-菜单权限关联（含 BUTTON 节点）
model RoleMenu {
  /// 角色 ID
  roleId String
  /// 菜单 ID（含 BUTTON 节点）
  menuId String
  /// 关联角色（级联删除）
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// 关联菜单（级联删除）
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  /// 联合主键（同一角色同一菜单仅一条）
  @@id([roleId, menuId])
}

/// 刷新令牌（登录后签发，轮换时旧令牌吊销）
model RefreshToken {
  /// 主键（cuid 全局唯一）
  id        String    @id @default(cuid())
  /// 所属用户
  userId    String
  /// 来源 IP（登录/签发时记录，x-forwarded-for 首个地址 ?? x-real-ip，取不到存 null）
  ip        String?
  /// 浏览器 UA（登录/签发时记录，取不到存 null）
  userAgent String?
  /// 令牌哈希（sha256，不存明文）
  tokenHash String    @unique
  /// 过期时间（签发后 7 天）
  expiresAt DateTime
  /// 吊销时间（null=有效）
  revokedAt DateTime?
  /// 创建时间（UTC）
  createdAt DateTime  @default(now())
  /// 所属用户（级联删除）
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 索引（定时清理按 expiresAt 范围删除，避免全表扫描）
  @@index([expiresAt])
}

/// 动态码（邮箱/手机号一次性验证码，OTP 登录用）
model OtpCode {
  /// 主键（cuid 全局唯一）
  id           String    @id @default(cuid())
  /// 渠道（EMAIL 邮箱 / TELEPHONE 手机号）
  channel      String
  /// 目标地址（邮箱地址或手机号）
  target       String
  /// 验证码哈希（sha256，不存明文）
  codeHash     String
  /// 过期时间（5 分钟）
  expiresAt    DateTime
  /// 已尝试次数（上限 5 次）
  attempts     Int       @default(0)
  /// 消费时间（null=未消费）
  consumedAt   DateTime?
  /// 创建时间（UTC）
  createdAt    DateTime  @default(now())
  /// 关联用户 ID（可空，未登录场景无关联）
  userId       String?
  /// 关联用户
  user         User?     @relation(fields: [userId], references: [id])

  /// 复合索引（每次 send/login 按 channel+target 查询最新记录，避免全表扫描）
  @@index([channel, target, createdAt])
}

/// 登录日志表（登录成功/失败审计；失败也记录尝试的用户名——防枚举场景）
model LoginLog {
  /// 主键（cuid 全局唯一）
  id        String   @id @default(cuid())
  /// 登录账号（尝试的用户名，失败也记录——防枚举场景）
  username  String
  /// 关联用户 ID（成功时有值）
  userId    String?
  /// 结果（SUCCESS 成功 / FAILED 失败，字符串 + zod 校验，兼容三方言）
  status    String
  /// 来源 IP（x-forwarded-for 首个地址 ?? x-real-ip，取不到存 null）
  ip        String?
  /// 浏览器 UA
  userAgent String?
  /// 失败原因（如 LOGIN_FAILED 错误码）
  message   String?
  /// 创建时间（UTC）
  createdAt DateTime @default(now())
  /// 关联用户（用户删除后置空，登录历史保留）
  user      User?    @relation(fields: [userId], references: [id])

  /// 索引（列表按 createdAt 倒序分页查询热点）
  @@index([createdAt])
}

/// 字典类型表（数据字典的类型定义，如 user_status；字典项见 DictItem）
model DictType {
  /// 主键（cuid 全局唯一）
  id          String    @id @default(cuid())
  /// 类型编码（程序引用用，如 user_status）
  typeCode    String    @unique
  /// 类型中文名称
  nameZh      String
  /// 类型英文名称（en 界面展示，未填回落 nameZh）
  nameEn      String?
  /// 类型描述
  description String?
  /// 启用状态（false=禁用）
  status      Boolean   @default(true)
  /// 排序值（列表展示顺序）
  sort        Int       @default(0)
  /// 创建时间（UTC）
  createdAt   DateTime  @default(now())
  /// 更新时间（UTC）
  updatedAt   DateTime  @updatedAt
  /// 字典项（删除类型时级联删除）
  items       DictItem[]
}

/// 字典项表（字典类型下的具体选项，如 user_status 的 enabled/disabled）
model DictItem {
  /// 主键（cuid 全局唯一）
  id        String   @id @default(cuid())
  /// 所属字典类型 ID
  typeId    String
  /// 项中文标签（界面展示）
  labelZh   String
  /// 项英文标签（en 界面展示，未填回落 labelZh）
  labelEn   String?
  /// 项值（程序使用）
  value     String
  /// 排序值（列表展示顺序）
  sort      Int      @default(0)
  /// 启用状态（false=禁用，禁用的项 options 接口不返回）
  status    Boolean  @default(true)
  /// 创建时间（UTC）
  createdAt DateTime @default(now())
  /// 更新时间（UTC）
  updatedAt DateTime @updatedAt
  /// 所属字典类型（级联删除）
  type      DictType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  /// 复合索引（按类型查询/排序字典项）
  @@index([typeId, sort])
}

/// 系统参数表（key-value 配置，如 user.password.minLength；程序运行时读取）
model Config {
  /// 主键（cuid 全局唯一）
  id          String   @id @default(cuid())
  /// 参数键（程序引用用，如 user.password.minLength）
  configKey   String   @unique
  /// 参数值
  configValue String
  /// 参数中文名称
  nameZh      String
  /// 参数英文名称（en 界面展示，未填回落 nameZh）
  nameEn      String?
  /// 参数说明
  description String?
  /// 启用状态（false=禁用）
  status      Boolean  @default(true)
  /// 创建时间（UTC）
  createdAt   DateTime @default(now())
  /// 更新时间（UTC）
  updatedAt   DateTime @updatedAt
}

/// 操作日志表（非 GET 写操作审计：操作人 / 接口 / 结果 / 耗时）
model OperationLog {
  /// 主键（cuid 全局唯一）
  id           String   @id @default(cuid())
  /// 操作用户 ID（未登录操作记录 null）
  userId       String?
  /// 操作账号（记录时从上下文取，null 表示未认证）
  username     String?
  /// HTTP 方法（POST/PATCH/PUT/DELETE 等）
  method       String
  /// 请求路径
  path         String
  /// 响应状态码
  statusCode   Int
  /// 处理耗时（毫秒）
  durationMs   Int
  /// 来源 IP（x-forwarded-for 首个地址 ?? x-real-ip，取不到存 null）
  ip           String?
  /// 浏览器 UA
  userAgent    String?
  /// 非 2xx 时的响应 message（可选）
  errorMessage String?
  /// 请求体 JSON 快照（仅 application/json 写操作；180 字符截断——兼容 MySQL 默认 VARCHAR(191)；
  /// 登录/OTP/改密/系统参数等敏感路径不记录）
  requestBody  String?
  /// 创建时间（UTC）
  createdAt    DateTime @default(now())
  /// 关联用户（用户删除时级联删除操作日志）
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 索引（列表按 createdAt 倒序分页查询热点）
  @@index([createdAt])
}

/// 站内通知表（系统/管理员发送，按接收用户隔离；发送方不落库，仅接收方可见）
model Notification {
  /// 主键（cuid 全局唯一）
  id        String   @id @default(cuid())
  /// 接收用户 ID
  userId    String
  /// 通知类型（预留分类，当前统一 SYSTEM）
  type      String   @default("SYSTEM")
  /// 通知标题
  title     String
  /// 通知内容
  content   String
  /// 是否已读（false=未读，顶栏徽标计数）
  isRead    Boolean  @default(false)
  /// 已读时间（标记已读时记录，未读为 null）
  readAt    DateTime?
  /// 创建时间（UTC）
  createdAt DateTime @default(now())
  /// 接收用户（用户删除时级联删除通知）
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 复合索引（按用户分页查询 + 未读数统计）
  @@index([userId, isRead, createdAt])
}

/// 公告表（全局公告：管理员发布，登录用户首页横幅展示）
model Announcement {
  /// 主键（cuid 全局唯一）
  id        String   @id @default(cuid())
  /// 公告标题
  title     String
  /// 公告内容（正文，可多行；MySQL 下需 @db.Text——默认 VARCHAR(191) 会截断，切库清单见 docs/database/README.md）
  content   String
  /// 发布状态（false=下架，下架后首页不再展示）
  status    Boolean  @default(true)
  /// 创建时间（UTC）
  createdAt DateTime @default(now())
  /// 更新时间（UTC）
  updatedAt DateTime @updatedAt

  /// 索引（首页 latest 按 createdAt 倒序查询）
  @@index([createdAt])
}
