{
  "name": "shadova",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:e2e": "eslint e2e",
    "test": "turbo run test",
    "typecheck": "pnpm --filter @repo/api typecheck && pnpm --filter @repo/web typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@commitlint/types": "^19.5.0",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "eslint": "^9.13.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "turbo": "^2.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
